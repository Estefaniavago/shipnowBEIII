# Variables del entorno de TESTING (se cargan solas cuando NODE_ENV=test).
# La base de datos debe ser descartable: se vacía antes de cada test y se elimina al terminar.
# El nombre de la base DEBE contener "test" (los tests se niegan a correr si no).
# Si necesitás otra URI (por ejemplo Atlas), NO pongas credenciales acá: definila como
# variable de entorno antes de correr, que tiene prioridad sobre este archivo.
PORT=3001
MONGODB_URI=mongodb://localhost:27017/shipnow_test
NODE_ENV=test

# Los archivos que suben los tests van a una carpeta aparte (se vacía en cada test).
# El nombre de la carpeta DEBE contener "test" (los tests se niegan a borrarla si no).
UPLOAD_DIR=uploads-test
UPLOAD_MAX_FILE_SIZE_MB=1
