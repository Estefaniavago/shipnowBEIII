{
  "name": "shipnow-api",
  "version": "1.0.0",
  "description": "API ShipNow con arquitectura Controller-Service-Repository",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:unit && npm run test:functional",
    "test:unit": "mocha \"tests/unit/**/*.test.js\"",
    "test:functional": "mocha --require ./tests/setup/db.hooks.js \"tests/functional/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "multer": "^2.0.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "chai": "^5.1.1",
    "mocha": "^10.7.3",
    "supertest": "^7.0.0"
  }
}
