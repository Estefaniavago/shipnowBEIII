# ============================================================
# DESARROLLO — copiá este archivo como .env y completá los valores.
# (Testing usa .env.test; producción recibe las variables del entorno / Docker.)
# ============================================================

# --- Obligatorias (la app NO arranca si falta alguna) ---
PORT=
MONGODB_URI=
NODE_ENV=

# --- Opcionales ---
# Nivel de log: fatal, error, warning, info, http, debug.
# Vacío => development: debug | production: info
LOG_LEVEL=

# URL pública de la API (por ejemplo https://api.tu-dominio.com). Se usa como servidor en Swagger.
PUBLIC_URL=

# Endpoints internos (mocks y logger test).
# Vacío => encendidos en development/test, APAGADOS en production.
ENABLE_INTERNAL_ENDPOINTS=
# Documentación Swagger (/api/docs). Vacío => encendida en todos los entornos.
ENABLE_DOCS=

# Carga de archivos
# Carpeta donde se guardan los archivos subidos (por defecto: uploads)
UPLOAD_DIR=
# Tamaño máximo por archivo en MB (por defecto: 5)
UPLOAD_MAX_FILE_SIZE_MB=
