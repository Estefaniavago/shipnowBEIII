# Copiá este archivo como .env y completá los valores reales
PORT=
MONGODB_URI=
NODE_ENV=

# Opcional: fuerza el nivel de log (fatal, error, warning, info, http, debug).
# Si se deja vacío: development => debug, production => info
LOG_LEVEL=

# Opcional: carga de archivos
# Carpeta donde se guardan los archivos subidos (por defecto: uploads)
UPLOAD_DIR=
# Tamaño máximo por archivo en MB (por defecto: 5)
UPLOAD_MAX_FILE_SIZE_MB=
