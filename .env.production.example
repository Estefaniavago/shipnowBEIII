# ============================================================
# PRODUCCIÓN — plantilla para "docker run --env-file .env.production".
# Copiala como .env.production (NO se sube al repo) y reemplazá los valores.
# Formato de --env-file: una variable por línea, SIN comillas.
# En plataformas de despliegue (Render, Railway, etc.) cargá estas variables en su panel.
# ============================================================
NODE_ENV=production
PORT=3000

# Base de datos real. Ejemplo (Atlas): mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/shipnow
MONGODB_URI=mongodb://USUARIO:CLAVE@HOST:27017/shipnow?authSource=admin

LOG_LEVEL=info
PUBLIC_URL=https://api.tu-dominio.com

# Mocks y logger test apagados (recomendado en producción). Swagger encendido.
ENABLE_INTERNAL_ENDPOINTS=false
ENABLE_DOCS=true

UPLOAD_MAX_FILE_SIZE_MB=5
